# =========================================================
# YPSG TECH PORTAL — BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in real values.
# Never commit the real .env file to version control.
# =========================================================

# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API (your frontend URL(s))
CLIENT_ORIGIN=http://localhost:3000,http://127.0.0.1:5500

# ---------- MySQL Database ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ypsg_tech_portal
DB_USER=root
DB_PASSWORD=changeme

# ---------- JWT ----------
# Use a long, random string in production (e.g. `openssl rand -hex 64`)
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Separate, equally long secret for admin-only tokens
ADMIN_JWT_SECRET=replace_this_with_a_different_long_random_secret
ADMIN_JWT_EXPIRES_IN=1d

# ---------- bcrypt ----------
BCRYPT_SALT_ROUNDS=12

# ---------- SMTP / Nodemailer ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password_or_app_password
MAIL_FROM_NAME=YPSG Tech Portal
MAIL_FROM_ADDRESS=info@ypsgtechportal.org

# ---------- Admin bootstrap ----------
# Used once by `npm run migrate` to create the first admin account.
ADMIN_EMAIL=admin@ypsgtechportal.org
ADMIN_PASSWORD=change_this_immediately
